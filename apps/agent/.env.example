# Copia este archivo como `.env` (en esta misma carpeta, apps/agent) y pon tu key.
# El .env NO se versiona: la key solo vive en el servidor, nunca llega al navegador.

# Crea la key en https://aistudio.google.com/ → "Get API key".
# Restríngela a "Gemini API". gemini-4-argon requiere facturación activa.
GEMINI_API_KEY=

# Modelo que compone la pantalla. Alternativas con nivel gratuito: gemini-3.6-flash o gemini-3.8-flash
# (si Google responde 503 "high demand", prueba la otra).
GEMINI_MODEL=gemini-4-argon

# Cuánto razona antes de responder: low | medium | high (low = más rápido)
GEMINI_THINKING_LEVEL=medium

# Orígenes del navegador autorizados (CORS). En desarrollo el front usa el proxy de Angular.
ALLOWED_ORIGINS=["http://localhost:4200"]

# true → el evento `done` incluye lo que escribió Gemini (útil en la charla: "Ver protocolo A2UI").
EXPOSE_LLM_OUTPUT=true

# Carpeta del contrato compartido (por defecto: packages/a2ui-catalog del monorepo).
# A2UI_CATALOG_DIR=../../packages/a2ui-catalog
