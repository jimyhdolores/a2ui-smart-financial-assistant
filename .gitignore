# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.
# Monorepo: las reglas sin "/" inicial aplican en cualquier carpeta (apps/web, apps/agent, …).

# Compiled output
dist/
tmp/
out-tsc/
bazel-out/

# Node
node_modules/
npm-debug.log
yarn-error.log

# Python (apps/agent)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Secretos: la API key de Gemini vive en apps/agent/.env (nunca se versiona)
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
.angular/
.sass-cache/
connect.lock
coverage/
libpeerconnection.log
testem.log
typings/
__screenshots__/

# System files
.DS_Store
Thumbs.db
.claude/
guion-demo-codigo.md
presentacion.md
