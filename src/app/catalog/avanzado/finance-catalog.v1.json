{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui-smart-financial-assistant/catalogs/finance/v1_0",
  "protocolVersion": "1.0",
  "title": "Catálogo de finanzas · Fintech Nano",
  "description": "Los 7 widgets del asistente financiero. Cada campo acepta un literal o un binding {\"@path\": \"/…\"} al modelo de datos de la superficie.",
  "catalogId": "https://a2ui-smart-financial-assistant/catalogs/finance/v1_0",
  "components": {
    "AppQuickStats": {
      "type": "object",
      "description": "Tira compacta de 4 cifras del mes: disponible, gasto, gastos hormiga y ahorro potencial. Buena cabecera de un panel.",
      "properties": {
        "component": { "const": "AppQuickStats" },
        "currency": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Símbolo de moneda." },
        "items": { "$ref": "common_types.json#/$defs/DynamicValue", "description": "Lista de cifras: {icon, label, value, tone: neutral|spend|warn|good}." }
      },
      "required": ["component"]
    },
    "AppAntExpense": {
      "type": "object",
      "description": "Gastos hormiga: veredicto con color, total del mes, comparación con el mes anterior, desglose por categoría y cuándo se agotaría el saldo. Con `interactive` muestra un deslizador «¿y si recorto X%?».",
      "properties": {
        "component": { "const": "AppAntExpense" },
        "status": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Veredicto: good | warning | risk." },
        "headline": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Titular del veredicto." },
        "message": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Explicación del veredicto." },
        "currency": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Símbolo de moneda." },
        "antTotal": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Total de gastos hormiga del mes." },
        "antCount": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Cantidad de gastos hormiga del mes." },
        "momPrevTotal": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Total de gastos hormiga del mes anterior." },
        "momDeltaPct": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Variación porcentual frente al mes anterior." },
        "momDirection": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Tendencia: up | down | flat." },
        "byCategory": { "$ref": "common_types.json#/$defs/DynamicValue", "description": "Desglose: {category, label, icon, total}[]." },
        "daysLeft": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Días hasta agotar el saldo al ritmo actual." },
        "depletionFrom": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Inicio de la ventana estimada de agotamiento." },
        "depletionTo": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Fin de la ventana estimada de agotamiento." },
        "reductionPct": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Porcentaje de recorte simulado (0–80)." },
        "interactive": { "$ref": "common_types.json#/$defs/DynamicBoolean", "description": "Si es true, muestra el deslizador de simulación (acción simulateReduction)." }
      },
      "required": ["component"]
    },
    "AppSpendingReport": {
      "type": "object",
      "description": "Reporte de gastos del mes: cifras clave, dona por categoría, tendencia semanal y las 5 compras más grandes.",
      "properties": {
        "component": { "const": "AppSpendingReport" },
        "title": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Título de la tarjeta." },
        "currency": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Símbolo de moneda." },
        "total": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Gasto total del mes." },
        "txCount": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Cantidad de gastos del mes." },
        "categories": { "$ref": "common_types.json#/$defs/DynamicValue", "description": "Por categoría: {category, label, icon, total, pct}[]." },
        "topCategory": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Categoría con más gasto." },
        "topCategoryTotal": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Gasto de esa categoría." },
        "trend": { "$ref": "common_types.json#/$defs/DynamicValue", "description": "Tendencia semanal: {label, value}[]." },
        "topMovements": { "$ref": "common_types.json#/$defs/DynamicValue", "description": "Compras más grandes: {date, merchant, amount, category, icon}[]." },
        "momDeltaPct": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Variación porcentual de gastos hormiga frente al mes anterior." },
        "momDirection": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Tendencia: up | down | flat." },
        "antTotal": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Total de gastos hormiga del mes." }
      },
      "required": ["component"]
    },
    "AppRecommendations": {
      "type": "object",
      "description": "Consejos personalizados con su impacto en dinero, nivel de riesgo y alertas.",
      "properties": {
        "component": { "const": "AppRecommendations" },
        "title": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Título de la tarjeta." },
        "currency": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Símbolo de moneda." },
        "riskLevel": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Riesgo: low | medium | high." },
        "tips": { "$ref": "common_types.json#/$defs/DynamicValue", "description": "Consejos: {icon, title, detail, impact}[]." },
        "alerts": { "$ref": "common_types.json#/$defs/DynamicValue", "description": "Alertas: {icon, text}[]." },
        "potentialTotal": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Ahorro total si se siguen los consejos." }
      },
      "required": ["component"]
    },
    "AppSavingsPlan": {
      "type": "object",
      "description": "Meta de ahorro con su progreso, el ahorro mensual posible y una proyección a 3 meses.",
      "properties": {
        "component": { "const": "AppSavingsPlan" },
        "title": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Título de la tarjeta." },
        "currency": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Símbolo de moneda." },
        "goalName": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Nombre de la meta." },
        "goalTarget": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Monto objetivo de la meta." },
        "goalCurrent": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Monto ahorrado hasta hoy." },
        "pct": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Progreso de la meta (0–100)." },
        "monthlyPotential": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Ahorro mensual posible." },
        "projection": { "$ref": "common_types.json#/$defs/DynamicValue", "description": "Proyección: {label, amount}[]." },
        "months": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Meses estimados para llegar a la meta." }
      },
      "required": ["component"]
    },
    "AppCreditAdvisor": {
      "type": "object",
      "description": "Capacidad de crédito: límite, deuda, disponible, uso y cuota máxima. Si hay una compra (product, price, months) simula la cuota y da un veredicto.",
      "properties": {
        "component": { "const": "AppCreditAdvisor" },
        "title": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Título de la tarjeta." },
        "currency": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Símbolo de moneda." },
        "limit": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Límite de la tarjeta." },
        "debt": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Deuda actual." },
        "available": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Crédito disponible." },
        "usagePct": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Porcentaje del límite en uso." },
        "capacity": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Cuota mensual máxima recomendable." },
        "minPayment": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Pago mínimo del mes." },
        "income": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Ingreso mensual estimado." },
        "riskLevel": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Riesgo: low | medium | high." },
        "recommendation": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Recomendación en una frase." },
        "product": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Producto a financiar (solo si se simula una compra)." },
        "price": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Precio de la compra simulada." },
        "months": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Número de cuotas." },
        "monthlyPayment": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Cuota mensual resultante." },
        "dti": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Porcentaje del ingreso que se lleva la cuota." },
        "verdict": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Veredicto de la compra: low | medium | high." }
      },
      "required": ["component"]
    },
    "AppMovementsTable": {
      "type": "object",
      "description": "Tabla de movimientos filtrada, con chips de filtro rápido (acción filterMovements).",
      "properties": {
        "component": { "const": "AppMovementsTable" },
        "title": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Título de la tarjeta." },
        "currency": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Símbolo de moneda." },
        "filterLabel": { "$ref": "common_types.json#/$defs/DynamicString", "description": "Descripción del filtro aplicado." },
        "rows": { "$ref": "common_types.json#/$defs/DynamicValue", "description": "Filas: {date, merchant, category, icon, amount, method, methodLabel, methodIcon}[]." },
        "total": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Suma de las filas." },
        "count": { "$ref": "common_types.json#/$defs/DynamicNumber", "description": "Cantidad de filas." }
      },
      "required": ["component"]
    }
  },
  "functions": {},
  "$defs": {
    "anyComponent": {
      "oneOf": [
        { "$ref": "#/components/AppQuickStats" },
        { "$ref": "#/components/AppAntExpense" },
        { "$ref": "#/components/AppSpendingReport" },
        { "$ref": "#/components/AppRecommendations" },
        { "$ref": "#/components/AppSavingsPlan" },
        { "$ref": "#/components/AppCreditAdvisor" },
        { "$ref": "#/components/AppMovementsTable" }
      ],
      "discriminator": { "propertyName": "component" }
    },
    "anyFunction": { "not": {} }
  }
}
