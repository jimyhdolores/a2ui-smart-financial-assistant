{
  "name": "a2ui-smart-financial-assistant",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "postinstall": "node scripts/setup-agent.mjs",
    "setup:agent": "node scripts/setup-agent.mjs",
    "start": "pnpm --filter web start",
    "dev": "concurrently --kill-others-on-fail --names agente,web --prefix-colors magenta,cyan \"pnpm dev:agent\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter web start",
    "dev:agent": "uv run --directory apps/agent fastapi dev --port 8787",
    "build": "pnpm --filter web build",
    "test:agent": "uv run --directory apps/agent pytest"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
